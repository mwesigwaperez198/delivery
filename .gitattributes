# Normalize line endings
* text=auto

# Force LF for these file types
*.dart text eol=lf
*.ts text eol=lf
*.js text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.md text eol=lf
*.sh text eol=lf
*.gradle text eol=lf
*.kts text eol=lf
*.xml text eol=lf
*.plist text eol=lf
*.swift text eol=lf
*.html text eol=lf
*.css text eol=lf

# Keep CRLF for Windows-specific files
*.bat text eol=crlf

# Binary files - no line ending conversion
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.jar binary
*.zip binary
